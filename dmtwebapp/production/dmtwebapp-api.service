[Unit]
Description=DMT WebApp student gateway
After=network.target postgresql.service
[Service]
Type=simple
User=dmtapi
Group=dmtapp
UMask=0027
Environment=DMT_DATA=/var/lib/web-manager/site-media/jsaiclass/dmtwebapp-prod
Environment=DMT_PORT=31107
Environment=DMT_DB=dmtwebapp
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/sites/jsaiclass/dmtwebapp/production/api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/web-manager/site-media/jsaiclass/dmtwebapp-prod/incoming
MemoryMax=160M
TasksMax=70
[Install]
WantedBy=multi-user.target
